{
  "name": "matundu-sms",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "deploy:cloudflare": "npm run build && NODE_OPTIONS=\"--dns-result-order=ipv4first\" npx -y wrangler pages deploy frontend/dist --project-name=kyamatu-frontend --branch=master",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
